# ── Supabase (Dashboard › Project Settings › API) ──
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=isi-anon-atau-publishable-key
# RAHASIA — hanya di server, jangan pernah dibagikan:
SUPABASE_SERVICE_ROLE_KEY=isi-service-role-atau-secret-key

# Email admin yang boleh masuk /admin (pisahkan dengan koma). Buat user-nya di Supabase › Authentication › Users.
ADMIN_EMAILS=emailkamu@gmail.com

# ── Toko ──
NEXT_PUBLIC_SITE_URL=https://tumbasmalih.com
# Nomor WhatsApp admin, format 62xxxxxxxxxx (tanpa + dan tanpa 0 di depan)
NEXT_PUBLIC_WHATSAPP_NUMBER=62812xxxxxxxx
# URL gambar QRIS (unggah ke bucket "produk", salin public URL). Kosongkan kalau belum ada.
NEXT_PUBLIC_QRIS_IMAGE_URL=
# Rekening transfer: Bank|Nomor|Nama;Bank|Nomor|Nama
BANK_ACCOUNTS="BCA|1234567890|Nama Pemilik;BRI|0987654321|Nama Pemilik"
# Ongkir flat per pesanan berisi barang fisik (rupiah)
SHIPPING_FLAT=15000

# ── Iklan (opsional) ──
NEXT_PUBLIC_META_PIXEL_ID=
