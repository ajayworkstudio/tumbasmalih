# Supabase (Dashboard › Project Settings › API)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=isi-anon-atau-publishable-key
# Rahasia, hanya untuk server. Jangan dibagikan:
SUPABASE_SERVICE_ROLE_KEY=isi-service-role-atau-secret-key

# Email admin yang boleh masuk /admin (pisahkan dengan koma). Buat user-nya di Supabase › Authentication › Users.
ADMIN_EMAILS=emailkamu@gmail.com

# Toko
NEXT_PUBLIC_SITE_URL=https://tumbasmalih.com
# Cadangan nomor WhatsApp (62xxxxxxxxxx) untuk halaman error. Nomor utama, rekening, QRIS,
# ongkir, dan kebijakan toko diatur dari /admin/pengaturan.
NEXT_PUBLIC_WHATSAPP_NUMBER=

# Bot Telegram: Akbar (administrasi), Venya (marketing), Bulan (inventori)
# Token dari @BotFather. Secret: string acak bebas (huruf/angka, 20+ karakter).
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
# ID Telegram yang boleh memerintah bot (kirim /start ke bot untuk melihat ID), pisahkan dengan koma
TELEGRAM_ALLOWED_IDS=
# Opsional: chat tujuan notifikasi pesanan baru dan laporan pagi (default: ID pertama di atas)
TELEGRAM_NOTIFY_CHAT_ID=
# Opsional: supaya Venya menulis draf caption/iklan dengan AI. Cukup isi salah satu key.
# Groq gratis tanpa kartu kredit: https://console.groq.com/keys
GROQ_API_KEY=
# Alternatif: Gemini (https://aistudio.google.com/apikey) atau Anthropic
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
# Opsional: paksa penyedia (groq | gemini | anthropic) dan model. Kosongkan untuk default.
AI_PROVIDER=
AI_MODEL=
# String acak untuk mengamankan laporan pagi otomatis (Vercel Cron)
CRON_SECRET=

# Iklan (opsional)
NEXT_PUBLIC_META_PIXEL_ID=
